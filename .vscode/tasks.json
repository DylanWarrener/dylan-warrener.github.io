{
  "label": "dev ready",
  "type": "shell",
  "command": "npm run dev",
  "isBackground": true,
  "options": {
    "env": {
      "NODE_ENV": "development",
      "NODE_OPTIONS": "--inspect=9230"
    }
  },
  "problemMatcher": {
    "owner": "nuxt",
    "pattern": {
      "regexp": "."
    },
    "background": {
      "activeOnStart": true,
      "beginsPattern": ".*",
      "endsPattern": ".*Local:.*http://localhost:3000.*"
    }
  }
}