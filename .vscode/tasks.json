{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev ready",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "options": {
        "env": {
          "NODE_ENV": "development",
          "NODE_OPTIONS": "--inspect=9230"
        }
      },
      "problemMatcher": {
        "owner": "nuxt",
        "pattern": {
          "regexp": "a^"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(ready|Local|localhost|Nuxt).*"
        }
      }
    }
  ]
}
