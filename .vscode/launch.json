{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "dev ready",
      "sourceMaps": true
    },
    {
      "name": "Backend",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full-stack: client + server",
      "configurations": ["Frontend", "Backend"],
      "stopAll": true
    }
  ]
}
