{
  "name": "dylan-warrener-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NUXT_ENV=development nuxt dev --host 0.0.0.0 --port 3000",
    "build:dev": "npm run format:check && npm run lint && npm run typecheck && cross-env NUXT_ENV=development nuxt build",
    "build:staging": "cross-env NUXT_ENV=staging nuxt build",
    "build:prod": "cross-env NUXT_ENV=production nuxt build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npx nuxi typecheck",
    "preview": "nuxt preview",
    "generate": "cross-env NUXT_ENV=production nuxt generate"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@nuxt/eslint": "^1.5.2",
    "@nuxt/icon": "^1.15.0",
    "@nuxt/image": "^1.10.0",
    "@nuxt/test-utils": "^3.19.2",
    "@pinia/nuxt": "^0.11.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "nodemailer": "^6.10.1",
    "nuxt": "^3.17.6",
    "pinia": "^3.0.3",
    "postcss": "^8.5.4",
    "vite-plugin-checker": "^0.9.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vuetify": "^3.8.12",
    "vuetify-nuxt-module": "^0.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@nuxt/eslint-config": "^1.4.1",
    "@types/node": "^22.16.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.10"
  }
}
